{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NLP stage request",
  "type": "object", "additionalProperties": false,
  "required": ["text", "lang", "spans"],
  "properties": {
    "text": {"type": "string"},
    "lang": {"enum": ["en", "ko", "ja", "zh-hans", "zh-hant"]},
    "spans": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["span", "concept"],
        "properties": {
          "span": {"description": "Offsets, half-open [start, end), in Unicode code points of the ORIGINAL text (not bytes, not UTF-16 units).", "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
          "concept": {"type": "integer", "minimum": 1000, "maximum": 9999}
        }
      }
    }
  }
}
