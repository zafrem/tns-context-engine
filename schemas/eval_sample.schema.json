{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eval sample (one JSON object per line)",
  "type": "object", "additionalProperties": false,
  "required": ["text", "lang", "labels", "source", "license"],
  "properties": {
    "text": {"type": "string", "minLength": 1},
    "lang": {"enum": ["en", "ko", "ja", "zh-hans", "zh-hant"]},
    "labels": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["concept", "span", "span_text"],
        "properties": {
          "concept": {"type": "integer", "minimum": 1000, "maximum": 9999},
          "span": {"description": "Half-open [start, end) offsets in Unicode code points (not bytes, not UTF-16 units).", "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
          "span_text": {"type": "string", "minLength": 1}
        }
      }
    },
    "source": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1}
  }
}
